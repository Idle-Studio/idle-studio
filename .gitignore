# Xcode
# Bare `**/xcuserdata/` — the *.xcodeproj/ prefixed patterns below miss nested
# cases such as *.xcodeproj/project.xcworkspace/xcuserdata/
**/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/
*.xccheckout
*.xcscmblueprint
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Secrets — never commit these. THIS REPOSITORY IS PUBLIC.
GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
Secrets.swift
secrets.json
.env
.env.*
!.env.example
# Local Claude Code permissions/settings — machine-specific, may contain paths.
# Previously only covered by the developer's personal global gitignore.
.claude/settings.local.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# CocoaPods (we use SPM, but just in case)
Pods/
Podfile.lock

# Carthage
Carthage/Build/

# Fastlane
# Leading `**/` so these match tools/release/fastlane/... too — the un-prefixed
# patterns only ever matched a top-level fastlane/ directory, which is why
# report.xml (ASC key id + issuer id) and Preview.html (reviewer phone number)
# were committed to a public repo.
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/**/*.png
**/fastlane/test_output
**/fastlane/README.md.bak

# IDE
.idea/
*.swp
*.swo
*~

# Coverage reports
*.gcda
*.gcno

# TestFlight / App Store
ExportOptions.plist

# Release automation
tools/release/vendor/
tools/release/.bundle/
tools/release/.venv/
/tmp/idle-studio-builds/
reports/

# Python
__pycache__/
*.py[cod]

# Website
website/node_modules/
website/.next/
website/out/
website/.env.local
website/tsconfig.tsbuildinfo
*.tsbuildinfo
